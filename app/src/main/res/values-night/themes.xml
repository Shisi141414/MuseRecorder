<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MuseRecorder" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_night</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/primary_night</item>
        <item name="android:statusBarColor">@color/primary_night</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="LegendText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">3dp</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/hintGray</item>
    </style>
</resources>
